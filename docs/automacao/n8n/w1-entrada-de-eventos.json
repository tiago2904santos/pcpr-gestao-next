      },
      "id": "0f824b0a-ce3a-57e0-b70d-2f03add44ec7",
      "name": "Webhook de eventos",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "webhookId": "e7ce5929-fb69-5f2e-bf3a-02e280e4078f"
    },
    {
      "parameters": {
        "jsCode": "// Corpo BRUTO (opção \"Raw Body\" do Webhook): a assinatura cobre os bytes exatos enviados pelo\n// PCPR — re-serializar o JSON mudaria espaços/escapes e quebraria (ou falsificaria) a checagem.\nconst AMBIENTE_ESPERADO = 'teste'; // trocar por 'producao' na instância de produção\nconst JANELA_S = 300;               // frescor: ±5 min\nconst item = $input.first();\nconst h = item.json.headers || {};\nlet bruto = '';\nconst bin = item.binary && item.binary.data;\nif (bin) {\n  if (bin.id) {\n    const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n    bruto = buf.toString('utf8');\n  } else {\n    bruto = Buffer.from(bin.data, 'base64').toString('utf8');\n  }\n}\nconst cab = String(h['x-pcpr-assinatura'] || '');\nconst m = /^t=(\\d+),v1=([a-f0-9]{64})$/.exec(cab);\nlet evento = null;\ntry { evento = JSON.parse(bruto); } catch (e) { evento = null; }\nconst agora = Math.floor(Date.now() / 1000);\nconst t = m ? Number(m[1]) : 0;\nreturn [{ json: {\n  formato_ok: Boolean(m && evento && typeof evento === 'object'),\n  frescor_ok: Boolean(m) && Math.abs(agora - t) <= JANELA_S,\n  v1: m ? m[2] : '',\n  mensagem_assinada: (m ? m[1] : '0') + '.' + bruto,\n  evento_id_cabecalho: String(h['x-pcpr-evento-id'] || ''),\n  ambiente_ok: Boolean(evento) && evento.ambiente === AMBIENTE_ESPERADO,\n  evento,\n} }];"
      },
      "id": "8e446869-9ad2-52a0-aac4-6d7751965730",
      "name": "Preparar verificação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.mensagem_assinada }}",
        "dataPropertyName": "hmac_calculado",
        "encoding": "hex"
      },
      "id": "db7d6708-3646-560a-98d2-c9ae756fb851",
      "name": "Calcular HMAC",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "crypto": {
          "id": "pcprHmacEventos1",
          "name": "PCPR · segredo HMAC dos eventos"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Comparação em tempo constante do HMAC calculado (nó Crypto, segredo na credencial) com v1.\nconst j = $input.first().json;\nconst a = String(j.hmac_calculado || '');\nconst b = String(j.v1 || '');\nlet dif = (a.length === 64 && b.length === 64) ? 0 : 1;\nfor (let i = 0; i < Math.min(a.length, b.length); i++) dif |= a.charCodeAt(i) ^ b.charCodeAt(i);\nconst ev = j.evento || {};\nlet motivo = 'ok';\nif (!j.formato_ok) motivo = 'formato';\nelse if (!j.frescor_ok) motivo = 'fora_da_janela';\nelse if (dif !== 0) motivo = 'assinatura';\nelse if (!j.ambiente_ok) motivo = 'ambiente';\nelse if (ev.id !== j.evento_id_cabecalho) motivo = 'id_divergente';\nconst valido = motivo === 'ok';\nreturn [{ json: { valido, motivo, evento: valido ? ev : null } }];"
      },
      "id": "602f7e40-29a8-518d-96b4-db9902353176",
      "name": "Validar assinatura e frescor",
