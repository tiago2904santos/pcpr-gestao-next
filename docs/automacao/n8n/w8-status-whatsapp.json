      "typeVersion": 1.1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "7c620239-cad3-511a-859d-34007af31bfc",
              "name": "cfg_pcpr",
              "value": "http://host.docker.internal:8765/api/automacao/v1",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "a47fdfc9-ec36-5e56-ab25-ba80ae13d5fd",
      "name": "Configuração",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// sent → nada (o resultado já registrou o aceite); delivered → entregue; read → lida;\n// failed → falhou. A comunicação vem de biz_opaque_callback_data ('com:<id>') quando houver.\nconst MAPA = { delivered: 'entregue', read: 'lida', failed: 'falhou' };\nconst cfg = $('Configuração').first().json;\nconst saida = [];\nfor (const it of $('Quando chamado pelo W7').all()) {\n  const s = it.json;\n  const status = MAPA[s.status];\n  if (!status) continue;\n  const m = /^com:(\\d+)$/.exec(String(s.biz_opaque_callback_data || ''));\n  const e = (s.errors || [])[0] || null;\n  saida.push({ json: {\n    cfg_pcpr: cfg.cfg_pcpr,\n    comunicacao_id: m ? Number(m[1]) : null,\n    wamid: String(s.id || ''),\n    status,\n    ocorrido_em: new Date(Number(s.timestamp || 0) * 1000).toISOString(),\n    erro: e ? ('código ' + e.code + ': ' + String(e.title || e.message || '')).slice(0, 300) : '',\n  } });\n}\nreturn saida;"
      },
      "id": "adb64935-9034-5470-a69d-f3b471d37765",
      "name": "Mapear status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "bbee6dc1-dea9-5f8d-9ac2-bb9074ed7a6e",
              "leftValue": "={{ $json.comunicacao_id !== null }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3a491a30-064d-590e-8fa8-b15d792af9c9",
      "name": "Tem comunicação?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.cfg_pcpr }}/comunicacoes?provedor_mensagem_id={{ encodeURIComponent($json.wamid) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      },
      "id": "3abec23d-cebd-5fdb-b470-ef32b7315603",
      "name": "Buscar pelo wamid",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        420
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "pcprApiToken0001",
          "name": "PCPR · token da API de automação"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Sem biz_opaque_callback_data: o PCPR resolve pelo mapeamento wamid → comunicação.\nconst ev = $('Mapear status').item.json;\nconst achado = ($json.itens || [])[0];\nreturn { json: { ...ev, comunicacao_id: achado ? achado.id : null } };"
      },
      "id": "30ee28ca-9231-5e8a-85b1-52aee751aabf",
      "name": "Usar id encontrado",
