        "numberInputs": 2
      },
      "id": "3207f3b5-6501-534e-bd13-8a8472e9bcb3",
      "name": "Juntar resultado",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        2200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// O W7 decide a resposta à Meta com isto: algum status adiado → não-2xx (a Meta reentrega).\nconst itens = $input.all();\nconst adiados = itens.filter((i) => i.json.adiar === true).length;\nreturn [{ json: { adiar: adiados > 0, adiados, registrados: itens.length - adiados } }];"
      },
