      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.cfg_pcpr }}/comunicacoes/{{ $json.comunicacao_id }}/entrega",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ (\"entrega:\" + (String($json.comunicacao_id) + \":\" + String($json.wamid) + \":\" + String($json.status))).length >= 16 && (\"entrega:\" + (String($json.comunicacao_id) + \":\" + String($json.wamid) + \":\" + String($json.status))).length <= 200 && /^[ -~]*$/.test(\"entrega:\" + (String($json.comunicacao_id) + \":\" + String($json.wamid) + \":\" + String($json.status))) ? \"entrega:\" + (String($json.comunicacao_id) + \":\" + String($json.wamid) + \":\" + String($json.status)) : \"entrega#sha256:\" + (String($json.comunicacao_id) + \":\" + String($json.wamid) + \":\" + String($json.status)).hash('sha256') }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ provedor_mensagem_id: $json.wamid, status: $json.status, ocorrido_em: $json.ocorrido_em, erro: $json.erro || undefined, tentativa: $json.tentativa || undefined }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "7dfd083a-a39e-53b6-ad95-94e1729ed249",
      "name": "Registrar entrega",
      "type": "n8n-nodes-base.httpRequest",
