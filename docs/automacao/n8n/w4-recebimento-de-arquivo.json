          "name": "Canal · token do webhook de entrada"
        }
      }
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "4cbdd6aa-6618-5997-bf23-b8493f9967af",
              "name": "cfg_pcpr",
