    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ erro: 'recebimento_nao_confirmado', aceitos: $json.aceitos, falhas: $json.falhas, total: $json.total }) }}",
        "options": {
