            },
            {
              "parameterType": "formData",
              "name": "em_resposta_a_comunicacao",
              "value": "={{ $json.em_resposta_a_comunicacao }}"
            }
          ]
        }
      },
      "id": "1d0a18c6-ebe9-5c89-b35c-5f1a43ce1aee",
      "name": "Entregar ao PCPR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "pcprApiToken0001",
          "name": "PCPR · token da API de automação"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "append",
        "numberInputs": 3
      },
      "id": "aa00e1f7-d538-5dc4-bcf4-95c0c588d67d",
      "name": "Juntar",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1760,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// 2xx ao canal SÓ se o PCPR aceitou todos os anexos (C9). Qualquer falha (download ou POST)\n// → 503: o canal reentrega a mensagem inteira; os anexos já aceitos repetem a mesma\n// Idempotency-Key e o PCPR devolve a resposta guardada, sem efeito novo.\nconst itens = $input.all();\nconst total = $('Separar anexos').all().length;\nconst falhas = itens.filter((i) => i.json.error !== undefined).length;\nconst aceitos = itens.length - falhas;\nreturn [{ json: { todos_aceitos: falhas === 0 && aceitos === total, aceitos, falhas, total } }];"
      },
      "id": "55e3390e-9511-5b2f-b416-60050ef45048",
      "name": "Decidir resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "f863fba9-e97a-5036-b05b-f40a0d5fe5f9",
              "leftValue": "={{ $json.todos_aceitos === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7db80068-aa9f-5b05-bb36-a240cf16ca37",
      "name": "Todos aceitos pelo PCPR?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2200,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ aceitos: $json.aceitos, total: $json.total }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "0d9177d2-5e33-5e37-9299-7b3cad21f1e8",
      "name": "Responder 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
