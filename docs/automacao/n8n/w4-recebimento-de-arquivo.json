        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "e331e64e-4146-5b55-9d0b-2e5b56709cfd",
      "name": "Configuração",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Um item por anexo: a chave do recebimento é receb:<canal>:<mensagem_id_canal>:<anexo_indice>\n// (contrato 10-6 E1; C3 do PR #23) e o PCPR consolida a mensagem por total_anexos.\nconst cfg = $('Configuração').first().json;\nconst b = cfg.body || {};\nconst anexos = Array.isArray(b.anexos) ? b.anexos : [];\nif (!anexos.length) return [{ json: { tem_anexo: false } }];\nreturn anexos.map((a, i) => ({ json: {\n  tem_anexo: true,\n  cfg_pcpr: cfg.cfg_pcpr,\n  cfg_canal: cfg.cfg_canal,\n  canal: String(b.canal || ''),\n  mensagem_id: String(b.mensagem_id || ''),\n  remetente: String(b.remetente || ''),\n  recebido_em: String(b.recebido_em || ''),\n  em_resposta_a_comunicacao: b.em_resposta_a_comunicacao ?? '',\n  arquivo_id: String(a.id || ''),\n  nome_arquivo: String(a.nome || ('anexo-' + i)),\n  anexo_indice: i,\n  total_anexos: anexos.length,\n} }));"
      },
      "id": "b4b7a649-45b1-57ba-9596-665b03fd3dfa",
      "name": "Separar anexos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "62abd68a-6085-54dc-9a2c-92d97e3f527d",
              "leftValue": "={{ $json.tem_anexo === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f367e886-fa41-5f32-9952-ccb0a4e9dd2d",
      "name": "Tem anexo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"erro\":\"mensagem_sem_anexo\"}",
        "options": {
          "responseCode": 422
        }
      },
      "id": "b0f1e5a2-c384-53ee-9056-45121a96f89c",
      "name": "Responder 422 (sem anexo)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        480
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.cfg_canal }}/arquivos/{{ $json.arquivo_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "arquivo"
            }
          }
        }
      },
      "id": "ef1d4e7a-086b-555a-90ee-428ac1d717b8",
      "name": "Baixar arquivo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "pcprCanalApi0001",
          "name": "Canal · chave de envio"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "binaryData": true,
        "binaryPropertyName": "arquivo",
        "dataPropertyName": "sha256",
        "encoding": "hex"
      },
      "id": "a0b3a2a5-4c34-56eb-844f-368f034cb024",
      "name": "Calcular SHA-256",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        1100,
        100
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: { ...$('Separar anexos').item.json, sha256: $json.sha256 }, binary: $('Baixar arquivo').item.binary };"
      },
      "id": "65dc5447-edb7-568b-a31c-f0844a44327b",
      "name": "Reanexar arquivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.cfg_pcpr }}/recebimentos",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "=receb:{{ $json.canal }}:{{ $json.mensagem_id }}:{{ $json.anexo_indice }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "arquivo",
              "inputDataFieldName": "arquivo"
            },
            {
              "parameterType": "formData",
              "name": "canal",
              "value": "={{ $json.canal }}"
            },
            {
              "parameterType": "formData",
              "name": "mensagem_id_canal",
              "value": "={{ $json.mensagem_id }}"
            },
            {
              "parameterType": "formData",
              "name": "anexo_indice",
              "value": "={{ $json.anexo_indice }}"
            },
            {
              "parameterType": "formData",
              "name": "total_anexos",
              "value": "={{ $json.total_anexos }}"
            },
            {
              "parameterType": "formData",
              "name": "nome_arquivo",
              "value": "={{ $json.nome_arquivo }}"
            },
            {
              "parameterType": "formData",
              "name": "remetente",
              "value": "={{ $json.remetente }}"
            },
            {
              "parameterType": "formData",
              "name": "recebido_em",
              "value": "={{ $json.recebido_em }}"
            },
