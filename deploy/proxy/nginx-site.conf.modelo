# Integração com um Nginx JÁ EXISTENTE no host (não suba o Caddy nesse caso).
# Copie para /etc/nginx/sites-available/pcpr-<instância>.conf, troque DOMINIO e PORTA,
# emita o certificado (ex.: certbot --nginx -d DOMINIO) e rode `nginx -t` ANTES do reload.

# Os tokens do feed ICS da agenda (/agenda/ics/<token>.ics) e do link do fornecedor
# (/fornecedor/<token>/) e dos links pessoais da automação (/p/<token>/) são credenciais: o log de
# acesso registra a URI com ele trocado por [token]. map/log_format valem para o http{} todo —
# o sufixo PORTA mantém os nomes únicos quando há mais de uma instância.
map $request_uri $pcpr_uri_PORTA {
    "~^(?<pcpr_ini_PORTA>.*/(?:agenda/ics|fornecedor|p)/)[^/?]+(?<pcpr_fim_PORTA>.*)$" "${pcpr_ini_PORTA}[token]${pcpr_fim_PORTA}";
    default $request_uri;
}
map $http_referer $pcpr_ref_PORTA {
    "~^(?<pcpr_rini_PORTA>.*/(?:agenda/ics|fornecedor|p)/)[^/?]+(?<pcpr_rfim_PORTA>.*)$" "${pcpr_rini_PORTA}[token]${pcpr_rfim_PORTA}";
    default $http_referer;
}
log_format pcpr_PORTA '$remote_addr - $remote_user [$time_local] '
                      '"$request_method $pcpr_uri_PORTA $server_protocol" $status $body_bytes_sent '
                      '"$pcpr_ref_PORTA" "$http_user_agent" $request_time';

server {
    listen 80;
    listen [::]:80;
    server_name DOMINIO;
    # Desafio ACME (certbot webroot) e redirecionamento para HTTPS.
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
    access_log /var/log/nginx/pcpr-DOMINIO.access.log pcpr_PORTA;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name DOMINIO;

    ssl_certificate     /etc/letsencrypt/live/DOMINIO/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMINIO/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:pcpr_ssl:10m;
    ssl_session_timeout 1d;

    # Importação até 25 MiB + formulário. Django mantém 16 MiB nas demais rotas.
    client_max_body_size 32m;
    server_tokens off;

    # Django já envia CSP, X-Frame-Options, nosniff, Referrer-Policy e COOP.
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Documentos e mídia nunca saem pelo proxy (só pelas views, com autorização).
    location ^~ /media/ { return 404; }
    location ^~ /var/   { return 404; }
    # API de automação: só a rede interna do n8n (Docker) chega nela, nunca a Internet.
    location ^~ /api/automacao/ { return 404; }

    location / {
        proxy_pass http://127.0.0.1:PORTA;
        proxy_set_header Host $host;
        # Sobrescreve o que o cliente mandar — a auditoria usa X-Real-IP.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 130s;
        proxy_send_timeout 130s;
        proxy_request_buffering on;
    }

    access_log /var/log/nginx/pcpr-DOMINIO.access.log pcpr_PORTA;
    # O error_log pode citar a linha da requisição (ex.: upstream lento) e não tem formato
    # configurável: mantenha-o legível só por root/adm (padrão do Debian/Ubuntu).
    error_log  /var/log/nginx/pcpr-DOMINIO.error.log warn;
}
