# Copie para .env e ajuste. Nunca versione o .env.
APP_ENV=dev                      # lab | dev | preview | staging | production
# DEMO_MODE=true só no PREVIEW (entrada sem senha); produção recusa — ADR 0011.
DEMO_MODE=false
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=troque-por-um-valor-aleatorio
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=pcpr_gestao
POSTGRES_USER=pcpr_gestao
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DOMINIO_EMAIL_INSTITUCIONAL=pc.pr.gov.br
# Somente para as ferramentas de comparação com o sistema de referência
# (scripts/referencia). Use credenciais próprias; não commitar.
REF_BASE_URL=https://eventos.gerenciadorviagens.tech
REF_USER=
REF_PASS=
