# Copie para .env e ajuste. Nunca versione o .env.
APP_ENV=dev                      # lab | dev | preview | staging | production
# DEMO_MODE=true só no PREVIEW (entrada sem senha); produção recusa — ADR 0011.
DEMO_MODE=false
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=troque-por-um-valor-aleatorio
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=pcpr_gestao
POSTGRES_USER=pcpr_gestao
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DOMINIO_EMAIL_INSTITUCIONAL=pc.pr.gov.br
# Somente para as ferramentas de comparação com o sistema de referência
# (scripts/referencia). Use credenciais próprias; não commitar.
REF_BASE_URL=https://eventos.gerenciadorviagens.tech
REF_USER=
REF_PASS=
# eProtocolo/PR — credenciais pedidas à Celepar/SEAP (PDS Mantis). Vazio = modo simulado.
# Ambientes: simulado | desenvolvimento | homologacao | treinamento | producao.
EPROTOCOLO_AMBIENTE=simulado
EPROTOCOLO_BASE_URL=
EPROTOCOLO_TOKEN_URL=
EPROTOCOLO_CLIENT_ID=
EPROTOCOLO_CLIENT_SECRET=
EPROTOCOLO_CONSUMER_ID=
EPROTOCOLO_ESCOPOS=spiserv.protocolos.consultar
EPROTOCOLO_SOMENTE_LEITURA=true
EPROTOCOLO_COD_ORGAO=
EPROTOCOLO_COD_LOCAL_ORIGEM=
EPROTOCOLO_COD_ASSUNTO_VIAGEM=
EPROTOCOLO_COD_ESPECIE_OFICIO=
